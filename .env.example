# Firebase Realtime Database — get these from
# Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — https://www.emailjs.com (free 200 emails/month)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# JSON Server — local dev API for settings/articles/categories/companies/currencies
VITE_JSON_SERVER_URL=http://localhost:3001

# Public base URL used in QR codes (printed on PDFs) and email links.
# Leave blank in production once deployed (window.location.origin is used).
# For LOCAL DEV with phone scanning, set this to your machine's LAN IP that
# Vite prints under "Network:" when starting (npm run dev). Example:
# VITE_PUBLIC_URL=http://192.168.1.5:5173
VITE_PUBLIC_URL=

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_REMPLACE_PAR_TA_CLE_STRIPE
